# Kestrel's descent — a sample course (linear run, start high -> finish low).
# Load it:  ./build/demo_fly3d src/video/tests/kestrel.course
#
# Each node is a control point on the flight path; a Catmull-Rom spline
# runs smoothly through them, and every field is interpolated between
# nodes so transitions are gradual.
#
# fields:  node   x    z    y   width  wall  ceil  lava
#   x,z   : map position (0..255)
#   y     : channel-floor height at the path centre (descends here)
#   width : corridor half-width (canyon wide vs tight)
#   wall  : how tall the rock walls rise above the floor
#   ceil  : tunnel headroom above the floor (0 = open sky)
#   lava  : lava-river half-width down the floor (0 = none)

loop 0

# floors stay ~level vs the rim (height 70) so the camera, which flies
# just above the rim, keeps the violet sky in view; walls rise to ~rim.
node   40   40   42   34    28    0     7
node   78   60   38   34    26    0     8     # widens out
node  116   96   44   30    30    0     5
node  150  120   40   38    22    0     0     # opens out, no lava
node  184  150   42   32    28    0     6     # back into canyon
node  214  186   40   34    30    0     7
node  236  220   38   36    24    0     6     # final straight
