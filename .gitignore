# =========================================================
# John's Cavalcade of Embedded Garbage
# Generic Embedded / C Development .gitignore
# =========================================================

# ---------------------------------------------------------
# Build directories
# ---------------------------------------------------------

build/
Build/
bin/
obj/
out/
dist/
Debug/
Release/

# CMake
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
cmake_install.cmake
Makefile

# Meson
.mesonpy-native-file.ini
.mesonpy-cross-file.ini
meson-private/
meson-logs/
meson-info/

# ---------------------------------------------------------
# Compiler outputs
# ---------------------------------------------------------

*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.dll
*.dylib
*.elf
*.axf
*.out
*.map
*.lst
*.sym

# Firmware images
*.bin
*.hex
*.uf2
*.dfu

# Linker garbage
*.su
*.idb
*.pdb

# Coverage / profiling
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# ---------------------------------------------------------
# Temporary files
# ---------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~

# ---------------------------------------------------------
# Logs
# ---------------------------------------------------------

*.log

# ---------------------------------------------------------
# Python (tooling/scripts)
# ---------------------------------------------------------

__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# ---------------------------------------------------------
